{
  "lab_id": "lab_main",
  "event_max_age_seconds": 15,
  "require_authority_snapshot": true,
  "fire_fusion": {
    "camera_zones": {},
    "device_zones": {},
    "confirmation_window_seconds": 10,
    "visual_minimum_confidence": 0.9,
    "visual_minimum_frames": 2,
    "visual_minimum_seconds": 1,
    "visual_maximum_gap_seconds": 5
  },
  "cooldown_seconds": 120,
  "principals": [
    {
      "id": "administrator",
      "role": "admin",
      "token_env": "LAB_MANAGEMENT_ADMIN_TOKEN"
    },
    {
      "id": "member_detector",
      "role": "producer",
      "labs": [
        "lab_main"
      ],
      "cameras": [
        "cam_1",
        "cam_2",
        "cam_entrance"
      ],
      "token_env": "LAB_MANAGEMENT_PRODUCER_TOKEN"
    }
  ],
  "routes": [
    {
      "id": "experimenters",
      "audience": "experimenters",
      "transport": "webhook",
      "labs": [
        "lab_main"
      ],
      "event_types": [
        "environment.flame",
        "environment.flame_recovered",
        "safety.no_mask",
        "safety.no_lab_coat",
        "safety.no_gloves"
      ],
      "webhook_env": "LAB_FEISHU_EXPERIMENTERS_WEBHOOK",
      "secret_env": "LAB_FEISHU_EXPERIMENTERS_SECRET"
    },
    {
      "id": "managers",
      "audience": "managers",
      "transport": "webhook",
      "labs": [
        "lab_main"
      ],
      "event_types": [
        "environment.flame",
        "environment.flame_recovered",
        "safety.no_mask",
        "safety.no_lab_coat",
        "safety.no_gloves"
      ],
      "webhook_env": "LAB_FEISHU_MANAGERS_WEBHOOK",
      "secret_env": "LAB_FEISHU_MANAGERS_SECRET"
    },
    {
      "id": "administrators",
      "audience": "administrators",
      "transport": "webhook",
      "labs": [
        "lab_main"
      ],
      "event_types": [
        "environment.flame",
        "environment.flame_recovered"
      ],
      "webhook_env": "LAB_FEISHU_ADMINISTRATORS_WEBHOOK",
      "secret_env": "LAB_FEISHU_ADMINISTRATORS_SECRET"
    }
  ],
  "silent_events": [
    "person.entered",
    "instrument.started"
  ],
  "evidence_required_events": [
    "safety.no_mask",
    "safety.no_lab_coat",
    "safety.no_gloves"
  ],
  "ppe_rules": {
    "mask": {
      "enabled": true,
      "minimum_confidence": 0.9
    },
    "lab_coat": {
      "enabled": false,
      "minimum_confidence": 0.9
    },
    "gloves": {
      "enabled": false,
      "minimum_confidence": 0.9
    }
  },
  "ppe_confirmation": {
    "minimum_frames": 3,
    "minimum_seconds": 5,
    "maximum_gap_seconds": 15,
    "escalation_seconds": 60
  },
  "evidence_image_origins": [
    "http://127.0.0.1:5175",
    "http://192.168.31.127:5175"
  ]
}
